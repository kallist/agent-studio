APP_ENV=development
WEB_PORT=3000
API_PORT=8000

POSTGRES_DB=agent_studio
POSTGRES_USER=agent_studio
DATABASE_URL=sqlite+aiosqlite:///./agent_studio.db
# DATABASE_URL_FILE=/run/secrets/database_url
POSTGRES_TEST_DATABASE_URL=postgresql+asyncpg://replace-with-test-user:replace-with-test-password@127.0.0.1:55432/agent_studio_test
POSTGRES_NO_VECTOR_TEST_DATABASE_URL=postgresql+asyncpg://replace-with-limited-test-user:replace-with-test-password@127.0.0.1:55432/agent_studio_no_vector_test
POSTGRES_TEST_ALLOW_DESTRUCTIVE_RESET=I_UNDERSTAND_THIS_DROPS_TEST_TABLES

OPENAI_API_KEY=
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
OPENAI_MODEL=
OPENAI_AGENTS_DISABLE_TRACING=1
OPENAI_REQUEST_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=512
RUN_REAL_OPENAI_TESTS=0
OPENAI_REAL_TEST_MODEL=
OPENAI_REAL_EMBEDDING_MODEL=
LLM_PROVIDER=openai
REQUIRE_LLM_PROVIDER_CONFIGURED=0
DEEPSEEK_API_KEY=
# DEEPSEEK_API_KEY_FILE=/run/secrets/deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_REQUEST_TIMEOUT_SECONDS=20
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_MAX_OUTPUT_TOKENS=512
RUN_REAL_DEEPSEEK_TESTS=0
DEEPSEEK_REAL_TEST_MODEL=deepseek-v4-flash
MOCK_PROVIDER_BLOCK_INPUT=
EMBEDDING_PROVIDER=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_STORAGE_PATH=./data/knowledge
KNOWLEDGE_MAX_FILE_BYTES=10485760
KNOWLEDGE_MAX_EXTRACTED_CHARS=2000000
KNOWLEDGE_MAX_CHUNKS=5000
KNOWLEDGE_PARSER_TIMEOUT_SECONDS=15
KNOWLEDGE_WORKER_COUNT=1
EVALUATION_WORKER_COUNT=1
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
ALLOWED_HOSTS=127.0.0.1,localhost
